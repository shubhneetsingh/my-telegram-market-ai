# ==============================================================================
# TELEGRAM BOT CONFIGURATION
# ==============================================================================
# Obtain your Bot Token from Telegram @BotFather: https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ==============================================================================
# AI PROVIDER & MODEL SELECTION
# ==============================================================================
# Options for AI_PROVIDER: 'nvidia', 'groq', 'openrouter', 'deepseek', 'ollama'
AI_PROVIDER=nvidia

# Selected Model Name:
# For NVIDIA (build.nvidia.com):
#   - nvidia/llama-3.1-nemotron-70b-instruct (NVIDIA's Flagship Reasoning Model)
#   - deepseek-ai/deepseek-r1 (DeepSeek Reasoning Model on NVIDIA NIM)
#   - meta/llama-3.3-70b-instruct
#   - qwen/qwen2.5-72b-instruct
#   - mistralai/mistral-large-2411
#
# For Groq:
#   - llama-3.3-70b-versatile
#   - deepseek-r1-distill-llama-70b
#
# For OpenRouter:
#   - deepseek/deepseek-r1
#   - meta-llama/llama-3.3-70b-instruct
#
# For Ollama (Local):
#   - llama3.2
#   - deepseek-r1
AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ==============================================================================
# API KEYS (Fill in the key for your chosen provider)
# ==============================================================================
# NVIDIA NIM API Key (Get free credits from https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# Groq Cloud API Key (Get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# DeepSeek API Key (Get from https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# Ollama Host (Default local URL: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ==============================================================================
# OPTIONAL: FIREBASE CRM SYNC (Leave blank if running in standalone mode)
# ==============================================================================
# FIREBASE_CREDENTIALS={"type": "service_account", ...}
ENABLE_CRM_SYNC=false
